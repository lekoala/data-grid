{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2018", "dom"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "./test/"]
}
